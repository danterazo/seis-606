# resolve make targets to repo root
repo_root="$(git rev-parse --show-superproject-working-tree 2>/dev/null)"
if [[ -z "${repo_root}" ]]; then
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
fi
if [[ " ${MAKEFLAGS:-} " != *" -C "* ]]; then
  export MAKEFLAGS="--no-print-directory -C ${repo_root} ${MAKEFLAGS:-}"
fi
