{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "make",
      "type": "process",
      "icon": {
        "id": "terminal",
        "color": "terminal.ansiMagenta"
      },
      "command": "bash",
      "args": ["-i"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "group": "project-terminals",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "echo": false,
        "showReuseMessage": false
      }
    },
    {
      "label": "bash",
      "type": "process",
      "icon": {
        "id": "terminal",
        "color": "terminal.ansiYellow"
      },
      "command": "bash",
      "args": ["-i"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "group": "project-terminals",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false,
        "echo": false,
        "showReuseMessage": false
      }
    },
    {
      "label": "Markdown: Export PDF (Pandoc)",
      "type": "process",
      "command": "pandoc",
      "args": [
        "${fileBasename}",
        "--pdf-engine=xelatex",
        "-V",
        "geometry:margin=0.7in",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.pdf"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": []
    }
  ]
}
